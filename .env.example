# Copie para .env (ja ignorado pelo git) e ajuste. O docker compose le o .env
# sozinho; sem ele valem os defaults abaixo. Nunca versione o .env.

# ── Banco ─────────────────────────────────────────────────────────────────────
# Senha do PostgreSQL do compose. Vazio = default "galaxy_dev" (aceitavel so para uso
# local: o banco so e publicado em 127.0.0.1). Na beta, os containers do backend e do
# seed recebem esta MESMA senha automaticamente.
# Atencao: POSTGRES_PASSWORD so vale na PRIMEIRA inicializacao do volume galaxy-pgdata.
POSTGRES_PASSWORD=

# So para o modo desenvolvimento: senha que o backend LOCAL (mvnw) usa para conectar.
# O Spring nao le este arquivo: exporte no ambiente antes de rodar o mvnw. Tem de ser
# igual a POSTGRES_PASSWORD. Vazio = default "galaxy_dev".
GALAXY_DB_PASSWORD=

# Porta do host onde o PostgreSQL do compose fica exposto (so em 127.0.0.1).
# 5433 porque a 5432 desta maquina ja esta ocupada por um PostgreSQL de servico
# do Windows. O backend local le GALAXY_DB_PORT (default 5433) — mantenha iguais.
POSTGRES_PORT=5433

# ── Beta (docker compose up) ──────────────────────────────────────────────────
# Porta do host onde a beta fica acessivel: http://127.0.0.1:8088 (so loopback).
GALAXY_HTTP_PORT=8088

# Onde ficam as imagens hospedadas na beta. Vazio = volume nomeado "galaxy-images".
# Use ./backend/data/images para compartilhar os arquivos com o backend local quando
# a beta usa um banco ja populado pelo modo desenvolvimento (ver README).
GALAXY_IMAGES_DIR=

# ── Backend local (modo desenvolvimento) ──────────────────────────────────────
# Interface onde o backend escuta. Padrao 127.0.0.1 (a API nao tem autenticacao).
# No container da beta ja vale 0.0.0.0, sem porta publicada no host.
# GALAXY_BIND_ADDRESS=127.0.0.1
