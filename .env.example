# Copie para .env (ja ignorado pelo git) e ajuste.

# Senha do PostgreSQL de desenvolvimento. Vazio = usa o default "galaxy_dev"
# do docker-compose.yml (aceitavel so em desenvolvimento local).
POSTGRES_PASSWORD=

# Senha que o BACKEND usa para conectar (o Spring nao le este arquivo: exporte no
# ambiente antes de rodar o mvnw). Tem de ser igual a POSTGRES_PASSWORD; se trocar so
# uma das duas, a conexao quebra. Vazio = default "galaxy_dev".
# Atencao: POSTGRES_PASSWORD so vale na PRIMEIRA inicializacao do volume galaxy-pgdata.
GALAXY_DB_PASSWORD=

# Porta do host onde o PostgreSQL do compose fica exposto (so em 127.0.0.1).
# 5433 porque a 5432 desta maquina ja esta ocupada por um PostgreSQL de servico
# do Windows. O backend le GALAXY_DB_PORT (default 5433) — mantenha os dois iguais.
POSTGRES_PORT=5433

# Interface onde o backend escuta. Padrao 127.0.0.1 (a API nao tem autenticacao).
# So use 0.0.0.0 dentro de container, publicando a porta em 127.0.0.1.
# GALAXY_BIND_ADDRESS=127.0.0.1
