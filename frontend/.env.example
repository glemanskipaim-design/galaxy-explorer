# Copie para .env.local se precisar mudar algo (arquivo ignorado pelo git).

# Alvo do proxy /api do Vite (so desenvolvimento/preview; NAO vai para o bundle do navegador,
# por isso nao tem prefixo VITE_). Default: http://127.0.0.1:8081 (8080 desta maquina esta ocupada).
# Use 127.0.0.1 e nao "localhost": o backend escuta so em IPv4 loopback.
# GALAXY_API_TARGET=http://127.0.0.1:8081
